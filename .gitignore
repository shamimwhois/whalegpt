# ------------------------------------------------------------------
# Dependencies & built assets
# ------------------------------------------------------------------
/node_modules
/vendor
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# ------------------------------------------------------------------
# Environment & secrets
# ------------------------------------------------------------------
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# ------------------------------------------------------------------
# Model weights
# ------------------------------------------------------------------
# Model files are detected at runtime (see config/whale.php) and can be
# multiple gigabytes — they must never end up in the repository.
*.gguf
*.safetensors

# ------------------------------------------------------------------
# Runtime data
# ------------------------------------------------------------------
/database/*.sqlite
/database/*.sqlite-*
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views
/storage/pail

# ------------------------------------------------------------------
# Local tooling & agent state
# ------------------------------------------------------------------
/.codex
/.cursor/
/.freebuff/
/.idea
/.kilo/
/.nova
/.phpactor.json
/.phpunit.cache
/.phpunit.result.cache
/.vscode
/.zed
_ide_helper.php
Homestead.json
Homestead.yaml

# ------------------------------------------------------------------
# Logs & OS files
# ------------------------------------------------------------------
*.log
.DS_Store
Thumbs.db

