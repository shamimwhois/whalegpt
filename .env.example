APP_NAME="Whale AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers (Laravel AI).
# Only providers with a value here are offered in the chat model picker.
# The picker reads these at runtime; run `php artisan config:clear` after editing.

# Ollama needs only a base URL:
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Local GGUF models.
#
# Drop .gguf files into the directory below and they are detected, profiled and
# offered in the model picker. The application only reads their headers for
# metadata: it never loads or executes the weights, so generation is delegated to
# one of the runtimes below. A runtime is only shown as ready once it answers a
# health probe, so a configured URL that points at nothing is reported as
# unreachable rather than silently failing on the first message.

# Where the .gguf files live. Defaults to app/Ai/Models.
# WHALE_MODELS_PATH=

# llama.cpp, for any text, vision or embedding model file:
#   llama-server --model app/Ai/Models/<file>.gguf --port 8080
# LOCAL_LLM_URL=http://localhost:8080

# A Python image server (diffusers or ComfyUI), required by diffusion GGUFs.
# llama.cpp cannot serve an image model.
# LOCAL_IMAGE_URL=http://localhost:7860

# Override the runtime endpoint paths if yours are not OpenAI-compatible.
# WHALE_RUNTIME_MODELS_PATH=/v1/models
# WHALE_RUNTIME_CHAT_PATH=/v1/chat/completions

# Capability inference reads the architecture and tensor names in each file.
# Set to false to report only what a runtime explicitly advertises.
# WHALE_DETECT_CAPABILITIES=true

# Metadata is cached against each file's size and modification time.
# WHALE_MODEL_CACHE_TTL=3600

# OpenAI unlocks images, audio and transcription as well as chat:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_AUDIO_MODEL=
# OPENAI_TRANSCRIPTION_MODEL=

# Any other provider, e.g. Anthropic, Gemini, Groq, DeepSeek, Mistral, xAI,
# OpenRouter, Cohere, Azure OpenAI, ElevenLabs, Bedrock or any OpenAI-compatible
# endpoint. See config/ai.php for every model variable each one accepts.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional: pin the default provider instead of auto-detecting from the keys
# above. Any provider name from config/ai.php works (ollama, openai, ...).
# AI_PROVIDER=ollama

# Optional external MCP servers whose tools are offered to agents
# (see config/mcp.php). Entries left empty are never connected.
# MCP_LINEAR_URL=
# MCP_LINEAR_TOKEN=
# MCP_FILESYSTEM_COMMAND=
