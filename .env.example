APP_NAME="Whale AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers (Laravel AI).
# Only providers with a value here are offered in the chat model picker.
# The picker reads these at runtime; run `php artisan config:clear` after editing.

# Ollama needs only a base URL:
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Custom providers.
#
# Any number of extra OpenAI-compatible endpoints (Pollinations, LM Studio,
# vLLM, Together, a gateway, a proxy) can be declared in one JSON array. Each
# becomes a named provider the picker offers, exactly like a built-in one. The
# key is optional; when set it is sent as a bearer token and never leaves the
# server.
#
#   WHALE_CUSTOM_PROVIDERS='[
#     {"name":"lmstudio","url":"http://127.0.0.1:1234/v1","key":""},
#     {"name":"gateway","url":"https://ai.example.com/v1","key":"sk-..."}
#   ]'
#
# The URL is the OpenAI-compatible base and must include /v1, because that is
# where /models and /images/generations live. A root URL that omits it will
# resolve to /models and /images/generations one level too high.
#
# Optional per entry: "label" for how it reads in the picker, "models" to pin a
# default model per capability, and "headers" for anything your gateway needs
# beyond the bearer token.
#
# Declaring an image model matters. The SDK's own OpenAI-compatible driver
# serves text, embeddings and transcription but not images, so an entry with no
# "image" model is registered as text-only and is refused if you try to select
# it for an image:
#
#   {"name":"pollinations","url":"https://gen.pollinations.ai/v1","key":"sk-...",
#    "models":{"image":{"default":"openai/gpt-image-2"},
#              "text":{"default":"openai/gpt-6-luna"}}}
#
# Keep a model id exactly as the endpoint serves it. A hosted gateway usually
# publishes owner-qualified ids like "openai/gpt-image-2", and the shortened
# "gpt-image-2" is not served.
#
# Open Settings -> Custom providers to list the models an endpoint serves, keep
# the ones you want, and sync later to pick up whatever changed.
# WHALE_CUSTOM_PROVIDERS=
#
# Appended to that base URL to ask it what it serves. Change this only if your
# catalogue lives somewhere else.
# WHALE_CUSTOM_PROVIDERS_MODELS_PATH=/models

# Local GGUF models.
#
# Drop .gguf files into the directory below and they are detected, profiled and
# offered in the model picker. The application only reads their headers for
# metadata: it never loads or executes the weights, so generation is delegated to
# one of the runtimes below. A runtime is only shown as ready once it answers a
# health probe, so a configured URL that points at nothing is reported as
# unreachable rather than silently failing on the first message.

# Where the .gguf files live. Defaults to app/Ai/Models.
# WHALE_MODELS_PATH=

# llama.cpp, for any text, vision or embedding model file:
#   llama-server --model app/Ai/Models/<file>.gguf --port 8080
# LOCAL_LLM_URL=http://localhost:8080

# A Python image server (diffusers or ComfyUI), required by diffusion GGUFs.
# llama.cpp cannot serve an image model.
# LOCAL_IMAGE_URL=http://localhost:7860

# Override the runtime endpoint paths if yours are not OpenAI-compatible.
# WHALE_RUNTIME_MODELS_PATH=/v1/models
# WHALE_RUNTIME_CHAT_PATH=/v1/chat/completions

# Capability inference reads the architecture and tensor names in each file.
# Set to false to report only what a runtime explicitly advertises.
# WHALE_DETECT_CAPABILITIES=true

# Metadata is cached against each file's size and modification time.
# WHALE_MODEL_CACHE_TTL=3600
# ============================================================
# Speech to text (live microphone + recorded audio)
# ============================================================
# The composer can transcribe speech two ways; the first available one wins.
#
# 1. Whistle (recommended, free and offline). A 16.9 MB on-device model from
#    Cactus Compute. It is a native binary, not a PHP package:
#      needle download windows-x64
#      needle download whistle
#    then point WHISTLE_BINARY at the extracted needle executable. It reads
#    16 kHz mono audio up to 30 seconds per clip, in 7 languages, and returns
#    word timings.
#
# 2. The AI SDK, using any provider that supports transcription. Ollama cannot
#    transcribe, so AI_PROVIDER=ollama alone is not enough for this path; set
#    e.g. GROQ_TRANSCRIPTION_MODEL or OPENAI_TRANSCRIPTION_MODEL.
#
# Browsers record WebM/Opus, which Whistle cannot read. Install FFmpeg so clips
# can be converted to 16 kHz mono WAV; without it only WAV uploads work.
#
# WHALE_STT_ENGINE=auto
# WHISTLE_BINARY=C:/cactus/needle/windows-x64/needle.exe
# WHISTLE_MODEL=whistle.cact
# WHISTLE_TIMEOUT=60
# Pin the language instead of detecting it: en, de, fr, es, it, nl, pl
# WHALE_SPEECH_LANGUAGE=en
# Terms the decoder is biased towards, comma separated.
# WHISTLE_KEYWORDS=Anthropic,Laravel,Whistle

# OpenAI unlocks images, audio and transcription as well as chat:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_AUDIO_MODEL=
# OPENAI_TRANSCRIPTION_MODEL=

# Any other provider, e.g. Anthropic, Gemini, Groq, DeepSeek, Mistral, xAI,
# OpenRouter, Cohere, Azure OpenAI, ElevenLabs, Bedrock or any OpenAI-compatible
# endpoint. See config/ai.php for every model variable each one accepts.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional: pin the default provider instead of auto-detecting from the keys
# above. Any provider name from config/ai.php works (ollama, openai, ...).
# AI_PROVIDER=ollama

# Optional external MCP servers whose tools are offered to agents
# (see config/mcp.php). Entries left empty are never connected.
# MCP_LINEAR_URL=
# MCP_LINEAR_TOKEN=
# MCP_FILESYSTEM_COMMAND=

# OAuth (authentication modal): Google and GitHub sign-in. Without these the
# modal still offers email and password; the provider buttons stay disabled.
# Register {APP_URL}/auth/google/callback and {APP_URL}/auth/github/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Comma-separated emails allowed into /admin. Empty means nobody can reach it.
WHALE_ADMIN_EMAILS=
